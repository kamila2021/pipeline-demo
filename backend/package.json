{
  "name": "backend-express5-postgres17",
  "version": "1.0.0",
  "description": "Backend API RESTful con Express 5 y PostgreSQL 17",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:seed": "node src/db/seed.js",
    "health": "node -e \"fetch('http://localhost:'+(process.env.PORT||5001)+'/health').then(r=>r.json()).then(console.log).catch(console.error)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}

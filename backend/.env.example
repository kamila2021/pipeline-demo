PORT=5001
NODE_ENV=development

# Opción A (local/CI): variables sueltas, sin SSL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskdb
DB_USER=postgres
DB_PASSWORD=postgres

# Opción B (producción, ej. Neon/Render Postgres): una sola connection string
# con SSL. Si está definida, tiene prioridad sobre las variables sueltas.
# DATABASE_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require


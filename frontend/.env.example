# Base del backend, SIN sufijo /api (cada llamada arma su propia ruta, ej. /api/tasks, /health).
# Déjala vacía o sin definir para desarrollo local (rutas relativas vía el proxy de Vite/Nginx).
# En producción (Vercel), apunta a la URL pública del backend en Render.
VITE_API_URL=http://localhost:5001
